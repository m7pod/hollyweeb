# Normalise line endings so the tree is identical on every OS.
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.yml   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.ansi  text eol=lf
*.txt   text eol=lf

*.png binary
*.gif binary
*.ico binary
